# Copy to .env.local. Public Firebase client config for project ci-connects —
# it identifies the project and does not authenticate; access is governed by
# firestore.rules. From a machine with the school gh login,
# `sh scripts/bootstrap.sh` at the repository root writes .env.local for you.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ci-connects.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ci-connects
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
