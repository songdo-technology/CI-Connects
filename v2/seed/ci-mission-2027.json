    {
      "id": "ci-mission-2027-01-keynote",
      "eventId": "ci-mission-2027",
      "title": "Opening Keynote: Human at the Centre in an Age of Intelligent Machines",
      "abstract": "Our mission asks us to develop global citizens with keen minds, exemplary character, self-knowledge and the ability to lead. What does each of those words demand of us now that machines can write, reason and persuade? A frank look at what technology should, and should not, be asked to carry.",
      "type": "keynote",
      "date": "2027-10-15",
      "start": "09:00",
      "end": "10:15",
      "roomId": "ci-mission-2027-r-main-theater",
