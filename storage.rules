rules_version = '2';

// Event cover images and speaker photos uploaded through the admin console.
// Reads are public because these appear on the public event pages; writes are
// limited to organisers and capped, since an unbounded upload path is the
// easiest way to run up a storage bill.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function role() {
      return signedIn()
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
        : 'anonymous';
    }
    function isOrganiser() { return role() in ['technical_admin', 'event_organizer']; }

    match /events/{eventId}/{fileName} {
      allow read: if true;
      allow write: if isOrganiser()
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Session materials. A speaker uploads to sessions they present; the rule
    // cannot read the session document to check that, so it is enforced by
    // role here and by the Firestore rule on the session itself, which is what
    // actually records the material against the session.
    match /sessions/{sessionId}/{fileName} {
      allow read: if true;
      allow write: if role() in ['technical_admin', 'event_organizer', 'speaker']
                   && request.resource.size < 25 * 1024 * 1024;
      allow delete: if role() in ['technical_admin', 'event_organizer'];
    }

    // Profile photos. Anyone signed in may write their own and only their own,
    // which is what makes this safe to leave open to every role.
    match /profiles/{uid}/{fileName} {
      allow read: if true;
      allow write: if signedIn()
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
