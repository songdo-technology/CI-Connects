rules_version = '2';

// ============================================================================
// CI Connects — Firestore security rules
//
// These rules are the security boundary. `src/lib/permissions.ts` mirrors them
// for the UI (hiding controls a user cannot use), but the client is never
// trusted: anything enforced there must also be enforced here.
//
// The layout is FLAT — one top-level collection per entity, matching
// src/lib/data/schema.ts. Documents carry their own eventId and queries narrow
// on it. These paths must stay in step with FirestoreStore; a mismatch is
// silently fatal, because the catch-all at the bottom denies anything these
// blocks do not name.
//
// Two principles run through the file:
//
//  1. A user's role lives on their own /users document and is NOT writable by
//     them. Otherwise anyone could promote themselves by editing their profile.
//
//  2. Reads are scoped to what a person legitimately needs. Attendance and
//     feedback are readable by their author and by organisers, not by the whole
//     conference — a delegate should not be able to enumerate who attended what.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers
    function signedIn()  { return request.auth != null; }
    function uid()       { return request.auth.uid; }
    function userDoc()   { return get(/databases/$(database)/documents/users/$(uid())).data; }
    function hasProfile(){ return exists(/databases/$(database)/documents/users/$(uid())); }
    function role()      { return signedIn() && hasProfile() ? userDoc().role : 'anonymous'; }

    function isAdmin()     { return role() == 'technical_admin'; }

    /** A Chadwick Workspace account, judged from the verified token. */
    function isInternal() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@chadwickschool[.]org');
    }

    /**
     * Somebody who has actually been given a place at an event.
     *
     * Set when an invitation is claimed. Anyone may hold an account — that is
     * what makes materials and certificates reachable — but holding one is not
     * the same as being part of the community, and the directory should not
     * open to the entire internet the moment self-registration does.
     */
    function hasEventAccess() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid()))
        && get(/databases/$(database)/documents/users/$(uid())).data.get('hasEventAccess', false) == true;
    }
    function isOrganiser() { return role() in ['technical_admin', 'event_organizer']; }
    function isDoorStaff() { return role() in ['technical_admin', 'event_organizer', 'front_desk']; }

    // Bootstrap problem: assigning a role requires an administrator, so the
    // first ones cannot be assigned by one. These addresses may provision
    // themselves with the role named here on first sign-in, and nobody else
    // can. Everyone else lands as an attendee and is promoted from the admin
    // panel. Keep in step with BOOTSTRAP_ROLES in src/lib/auth.ts.
    function bootstrapRole(email) {
      return email == 'songdo-technology@chadwickschool.org' ? 'technical_admin'
           : email == 'dnorman@chadwickschool.org'           ? 'technical_admin'
           : email == 'wpaetzold@chadwickschool.org'         ? 'event_organizer'
           : 'none';
    }

    // True when the incoming write leaves the named fields untouched.
    function unchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields.toSet());
    }

    // True when the write touches only the named fields.
    function onlyTouches(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // Event managers run every event, not only ones they created, so event
    // content is gated by role rather than by ownership. ownerId is still
    // recorded — it says who created the event, and an audit reads it — but it
    // no longer decides who may edit.

    // ------------------------------------------------------------------ users
    match /users/{userId} {
      // One profile at a time: needed to name a session's speaker, or to show
      // who sent a message.
      allow get: if signedIn();

      /**
       * The whole directory, which is a different question.
       *
       * Open registration means anybody in the world can hold an account, and
       * allowing every account to enumerate this collection would publish the
       * name, title, organisation and email of every member of staff to
       * whoever signed up this morning. Reading the directory belongs to
       * people who are part of the community: Chadwick accounts, organisers,
       * and guests who have claimed a place at an event.
       */
      allow list: if isInternal() || isOrganiser() || hasEventAccess();

      // Own profile, but never own role. Admins may change anything, and
      // organisers may put people on and off an event's list — nothing else.
      allow update: if isAdmin()
                    || (isOrganiser() && onlyTouches(['eventAccess', 'hasEventAccess']))
                    || (signedIn() && uid() == userId && unchanged(['role', 'id', 'email']));

      // Two ways a user document comes into being.
      //
      // Organisers provision accounts for other people — visiting guests who
      // have no Chadwick login, and the seeded sample directory. Only an admin
      // may mint another administrator; an organiser inviting a guest must not
      // be able to hand out their own level of access.
      allow create: if isAdmin()
                    || (isOrganiser() && request.resource.data.role != 'technical_admin');

      // Or a person provisions themselves on first sign-in, pinned to their
      // own identity. Everyone lands as an attendee; the bootstrap list is the
      // single exception, and exists only so the first administrator can come
      // to be.
      allow create: if signedIn()
                    && uid() == userId
                    && request.resource.data.email == request.auth.token.email
                    && (
                      request.resource.data.role == 'attendee'
                      || request.resource.data.role == bootstrapRole(request.auth.token.email)
                    );

      allow delete: if isAdmin();
    }

    // ----------------------------------------------------------------- events
    match /events/{eventId} {
      // Published events are the public website. Drafts are organisers only.
      allow read: if resource.data.get('status', 'published') == 'published' || isOrganiser();
      allow create: if isOrganiser() && request.resource.data.ownerId == uid();
      allow update: if isOrganiser();
      allow delete: if isOrganiser();
    }

    // -------------------------------------------------------------- programme
    // Public alongside their event, writable by whoever runs it.
    match /sessions/{sessionId} {
      allow read: if true;
      allow create, delete: if isOrganiser();

      allow update:
        // Organisers and admins: anything.
        if isOrganiser()
        // A speaker may edit their own session, but not capacity, room or
        // reservations — the fields that would let them oversubscribe a room.
        || (role() == 'speaker'
            && uid() in resource.data.get('speakerIds', [])
            && unchanged(['maxAttendees', 'reservedUserIds', 'waitlistUserIds',
                          'roomId', 'speakerIds', 'eventId']))
        // Attendees manage their own seat. Constrained to the reservation
        // arrays so a booking cannot smuggle in a title or capacity change.
        || (signedIn() && onlyTouches(['reservedUserIds', 'waitlistUserIds']));
    }

    match /tracks/{trackId}   { allow read: if true; allow write: if isOrganiser(); }
    match /rooms/{roomId}     { allow read: if true; allow write: if isOrganiser(); }
    match /sponsors/{sponsorId} { allow read: if true; allow write: if isOrganiser(); }

    match /mealServices/{serviceId} {
      allow read: if true;
      allow create, delete: if isOrganiser();
      // Attendees pick a meal; that touches `selections` and nothing else.
      allow update: if isOrganiser() || (signedIn() && onlyTouches(['selections']));
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isOrganiser();
    }

    // ------------------------------------------------------------- attendance
    // Written by door staff, never edited afterwards — an attendance record
    // that can be changed later is not evidence of anything.
    match /attendance/{recordId} {
      allow read: if isOrganiser() || (signedIn() && resource.data.userId == uid());
      allow create: if isAdmin()
                    || (isDoorStaff() && request.resource.data.scannedBy == uid());
      allow update, delete: if false;
    }

    // --------------------------------------------------------------- feedback
    // Authors read their own; organisers read all. Nothing is deletable —
    // retracting feedback after an organiser has read it would undermine the
    // record.
    match /feedback/{entryId} {
      allow read: if isOrganiser() || (signedIn() && resource.data.userId == uid());
      allow create: if isAdmin()
                    || (signedIn()
                        && request.resource.data.userId == uid()
                        && request.resource.data.rating is int
                        && request.resource.data.rating >= 1
                        && request.resource.data.rating <= 5);
      allow update: if signedIn()
                    && resource.data.userId == uid()
                    && unchanged(['userId', 'targetId', 'submittedAt']);
      allow delete: if false;
    }

    // -------------------------------------------------------------- community
    match /communityTopics/{topicId} {
      allow read: if signedIn();
      // isAdmin() covers seeding and imports, where the author is someone else.
      allow create: if isAdmin()
                    || (signedIn() && request.resource.data.authorId == uid());
      allow update: if isOrganiser()
                    || (signedIn() && resource.data.authorId == uid())
                    // Anyone signed in may RSVP, like or reply, and nothing else.
                    || (signedIn() && onlyTouches(['rsvpUserIds', 'likesCount', 'replies']));
      allow delete: if isOrganiser() || (signedIn() && resource.data.authorId == uid());
    }

    // --------------------------------------------------------------- messages
    // Readable only by the two participants. Organisers are deliberately
    // excluded: running an event does not entitle anyone to read private mail.
    match /messages/{messageId} {
      allow read: if signedIn() && uid() in [resource.data.fromUserId, resource.data.toUserId];
      // The recipient's opt-out is enforced here, not only in the interface —
      // a client that skipped the check would otherwise still get through.
      allow create: if isAdmin()
                    || (signedIn()
                        && request.resource.data.fromUserId == uid()
                        && get(/databases/$(database)/documents/users/$(request.resource.data.toUserId))
                             .data.get('allowMessages', true) == true);
      // Only the recipient may mark a message read.
      allow update: if signedIn()
                    && resource.data.toUserId == uid()
                    && onlyTouches(['read']);
      allow delete: if false;
    }

    // ----------------------------------------------------------- lucky draw
    // Prizes are public so the wheel can show what is on offer; only
    // organisers create them or record a winner.
    match /prizes/{prizeId} {
      allow read: if true;
      allow write: if isOrganiser();
    }

    // ---------------------------------------------------------------- spend
    // Budget lines are not public. What an event cost is an internal matter,
    // and putting it behind the organiser role keeps it that way.
    match /costs/{costId} {
      allow read: if isOrganiser();
      allow write: if isOrganiser();
    }

    // -------------------------------------------------------------- invites
    // An invited guest must be able to read their own invitation on first
    // sign-in, to adopt the name and role an organiser recorded for them —
    // matched on the email in their verified token, never on a supplied value.
    // Everything else about invites is organisers only, because the collection
    // is a list of who is coming.
    /**
     * Certificates of professional learning.
     *
     * `get` is public and `list` is not, which is the whole design: the code
     * is the capability. A licensing body holding one certificate can check
     * that certificate without an account — requiring a sign-in to verify a
     * credential would make the credential useless — while nobody can
     * enumerate the collection and harvest the name, organisation and
     * attendance of every teacher who ever came.
     *
     * Only organisers issue, and nobody deletes: a code printed on a document
     * somebody already holds must keep answering. Withdrawing one sets
     * revokedAt, so the answer becomes "issued, then withdrawn" rather than
     * "no such certificate", which would read as an accusation of forgery.
     */
    match /certificates/{code} {
      allow get: if true;
      allow list: if isOrganiser();
      allow create: if isOrganiser();
      allow update: if isOrganiser();
      allow delete: if false;
    }

    /**
     * Access-code lookups, keyed by a hash of email plus code.
     *
     * `get` is public because the hash is the question and the answer at once:
     * knowing the pair finds the document, and not knowing it finds nothing.
     * `list` is refused, so the collection cannot be swept for guest
     * addresses — and the documents hold neither an address nor a code, only
     * which invitation they belong to.
     *
     * Finding one causes a sign-in link to be sent to the invited address.
     * It admits nobody by itself.
     */
    match /inviteCodes/{hash} {
      allow get: if true;
      allow list: if isOrganiser();
      allow write: if isOrganiser();
    }

    match /invites/{inviteId} {
      allow read: if isOrganiser()
                  || (signedIn() && resource.data.email == request.auth.token.email);
      allow create, delete: if isOrganiser();
      // The invitee may only mark their own invitation claimed.
      allow update: if isOrganiser()
                    || (signedIn()
                        && resource.data.email == request.auth.token.email
                        && onlyTouches(['claimedAt', 'claimedByUid']));
    }

    // -------------------------------------------------------- signage takeover
    // Read by unauthenticated display players, so world-readable by design.
    // Keep nothing sensitive in here.
    match /signage/{docId} {
      allow read: if true;
      allow write: if isOrganiser();
    }

    // Deny anything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }

    // ================================================================== v2
    // The rebuild lives under /v2/data/<collection>/<id>, beside v1's data,
    // with its own three roles: admin, schedule_admin, user. Nothing below
    // reads a v1 document.
    function v2Exists() { return exists(/databases/$(database)/documents/v2/data/users/$(request.auth.uid)); }
    function v2Me()     { return get(/databases/$(database)/documents/v2/data/users/$(request.auth.uid)).data; }
    function v2Role()   { return signedIn() && v2Exists() ? v2Me().role : 'anonymous'; }
    function v2Admin()  { return v2Role() == 'admin'; }
    function v2Staff()  { return v2Role() in ['admin', 'schedule_admin']; }
    function v2Email()  { return signedIn() && request.auth.token.email is string ? request.auth.token.email.lower() : ''; }
    // An invitation is named after the event and the address, so a token can
    // prove one exists without a query.
    function v2Invited(eventId) {
      return signedIn() && v2Email() != ''
        && exists(/databases/$(database)/documents/v2/data/invites/$(eventId + '__' + hashing.sha256(v2Email()).toHexString().lower()));
    }
    function v2Listed(eventId) { return signedIn() && v2Exists() && eventId in v2Me().get('eventAccess', []); }
    function v2CanSee(eventId) { return v2Staff() || v2Listed(eventId) || v2Invited(eventId); }
    function v2Bootstrap(email) { return email in ['songdo-technology@chadwickschool.org', 'jyyang@chadwickschool.org']; }
    function v2OnlyTouches(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }

    match /v2/data/users/{userId} {
      allow get: if signedIn() && (userId == uid() || v2Staff());
      allow list: if v2Staff() || (signedIn() && resource.data.id == uid());
      // Self-provisioning on first sign-in: as a member, or as an
      // administrator for the bootstrap addresses. Never with a list.
      allow create: if signedIn() && userId == uid()
                    && request.resource.data.email == v2Email()
                    && request.resource.data.eventAccess.size() == 0
                    && (request.resource.data.role == 'user'
                        || (request.resource.data.role == 'admin' && v2Bootstrap(v2Email())));
      // One's own profile, but never one's role, address or lists.
      allow update: if v2Admin()
                    || (signedIn() && userId == uid()
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email', 'id', 'eventAccess']));
      allow delete: if v2Admin();
    }

    match /v2/data/invites/{inviteId} {
      allow read: if v2Admin() || (signedIn() && resource.data.email == v2Email());
      allow create, update, delete: if v2Admin();
    }

    match /v2/data/events/{eventId} {
      allow read: if v2Staff() || resource.data.status == 'published';
      allow create, update, delete: if v2Admin();
    }

    match /v2/data/sessions/{sessionId} {
      allow read: if v2CanSee(resource.data.eventId);
      allow create, delete: if v2Staff();
      // A listed person manages their own seat. Constrained to the two
      // arrays, so a booking cannot smuggle in a title or a capacity.
      allow update: if v2Staff()
                    || (v2CanSee(resource.data.eventId) && v2OnlyTouches(['reservedUserIds', 'waitlistUserIds']));
    }

    match /v2/data/rooms/{roomId} {
      allow read: if v2CanSee(resource.data.eventId);
      allow write: if v2Staff();
    }

    match /v2/data/tracks/{trackId} {
      allow read: if v2CanSee(resource.data.eventId);
      allow write: if v2Staff();
    }

    match /v2/data/attendance/{recordId} {
      allow read: if v2Staff() || (signedIn() && resource.data.userId == uid());
      allow write: if v2Staff();
    }

    match /v2/data/announcements/{announcementId} {
      allow read: if signedIn();
      allow write: if v2Admin();
    }

    match /v2/data/feedback/{feedbackId} {
      allow read: if v2Staff() || (signedIn() && resource.data.userId == uid());
      allow create, update: if signedIn() && request.resource.data.userId == uid() && v2CanSee(request.resource.data.eventId);
      allow delete: if v2Admin();
    }

    match /v2/data/settings/{docId} {
      allow read: if true;
      allow write: if v2Admin();
    }

  }
}
