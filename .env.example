# Firebase web app config.
# These values are safe in client code — Firebase identifies the project with
# them, it does not authenticate with them. Access is controlled by
# firestore.rules, not by keeping these secret.
#
# Copy to .env.local and fill from:
#   Firebase console -> Project settings -> Your apps -> Web app -> SDK config
VITE_FIREBASE_API_KEY=
# NOTE: this is deliberately NOT <project>.firebaseapp.com any more.
# The OAuth handler is proxied from this site's own origin by
# functions/__/auth/[[path]].js, because a cross-site handler cannot return a
# credential in any current browser — see docs/auth-domain-runbook.md.
# Production value: ci-events.pages.dev
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Restricts Google sign-in to your Workspace domain.
VITE_ALLOWED_EMAIL_DOMAIN=chadwickschool.org

# Flip to 'true' only after the database has been seeded via the first-run
# setup screen. Firestore mode against an empty database shows the setup
# screen; against a seeded one it is the real backend.
VITE_USE_FIRESTORE=false

# ---------------------------------------------------------------------------
# NOT part of this file: the Cloudflare Pages Function secrets.
#
# These are never built into the bundle — a model API key shipped to the
# browser is readable by anyone who opens devtools. They are set in the
# Cloudflare dashboard under Workers & Pages -> ci-events -> Settings ->
# Variables and secrets:
#
#   FIREBASE_API_KEY    same value as VITE_FIREBASE_API_KEY above; the
#                       endpoints use it to verify the caller is signed in
#   GEMINI_API_KEY      optional; enables agenda structuring and cover-image
#                       generation.  https://aistudio.google.com/apikey
#   ANTHROPIC_API_KEY   optional alternative to GEMINI_API_KEY for text
#
# See docs/ai-assist-setup.md.
