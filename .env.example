# Firebase web app config.
# These values are safe in client code — Firebase identifies the project with
# them, it does not authenticate with them. Access is controlled by
# firestore.rules, not by keeping these secret.
#
# Copy to .env.local and fill from:
#   Firebase console -> Project settings -> Your apps -> Web app -> SDK config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Restricts Google sign-in to your Workspace domain.
VITE_ALLOWED_EMAIL_DOMAIN=chadwickschool.org
